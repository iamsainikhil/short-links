# ─────────────────────────────────────────────────────────────────────────────
# Short Links – environment variables
# Copy to .env.local for local development and into Vercel for production.
# ─────────────────────────────────────────────────────────────────────────────

# Public site base URL used to build /l/<slug> short links everywhere
# (landing page, dashboard copy buttons, seed script). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://iamsainikhil.com

# Private mode: when true, only the first Google sign-in becomes the owner.
# Gates everything except the public landing page and /l/* redirects.
NEXT_PUBLIC_PRIVATE_MODE=true

# Base path for subpath deployments (e.g. serving under /short-links).
# Leave empty (or unset) for a root-level deployment. Default: "" (root).
NEXT_PUBLIC_BASE_PATH=

# Firebase Client SDK environment variables (safe for the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=<value>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<value>
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<value>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<value>
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<value>
NEXT_PUBLIC_FIREBASE_APP_ID=<value>

# Firebase Admin SDK environment variables (server-side, never exposed)
# Used by the /l/[slug] redirect handler and the seed script.
FIREBASE_PROJECT_ID=<value>
FIREBASE_CLIENT_EMAIL=<value>
FIREBASE_PRIVATE_KEY=<value>  # service account key; escape newlines as \n when pasting

# Salt for IP-range hashing in click analytics (server-side only)
# Generate with: openssl rand -base64 32
SCAN_IP_HASH_SALT=<strong-random-secret>

# Optional: owner UID used by `npm run seed-demo`. If unset, the script reads
# the owner from app_config/private (set automatically by the first sign-in).
# FIREBASE_OWNER_UID=<value>